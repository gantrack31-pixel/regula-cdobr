# Local demonstration. Disable before exposing to a network.
DEMO_MODE=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# On a desktop with limited free VRAM, run the small embedding model on CPU.
# EMBEDDING_NUM_GPU=0
# For first start with DEMO_MODE=0, set a unique password >= 12 characters.
# ADMIN_PASSWORD=replace-with-a-unique-long-password
ALLOWED_HOSTS=localhost,127.0.0.1
# COOKIE_SECURE=1
# ALLOWED_ORIGINS=portal.example.org
